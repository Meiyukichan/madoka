# 包管理状态全部留在包内，不写 %LOCALAPPDATA% / 全局 cache
# （受限权限下 pnpm 的全局 store / lock 会直接 EPERM）
store-dir=./.pnpm-store
cache-dir=./.pnpm-cache
# 本机 pnpm 的 symlinkAllModules 在深目录下会爆栈；hoisted 链接器避开符号链接农场
node-linker=hoisted
package-import-method=copy
fund=false
audit=false
# 本机沙箱封锁运行前的隐式 install 校验
verify-deps-before-run=false
