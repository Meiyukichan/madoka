{
  "name": "@meiyukichan/dsh-magica-rune",
  "version": "0.2.0-alpha.7",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./assets/icon-180.png",
  "description": "DSH 能力管理：按全局或工作区启用 / 禁用任意工具与技能。被禁项同时从模型的工具清单与系统提示词中移除，运行期再兜底拦截；支持搜索、分组批量与内置保护，改动即时生效、无需重启。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meiyukichan/madoka.git",
    "directory": "dsh-magica-rune"
  },
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=11"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "resources",
    "assets/icon-180.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.dts.json --noEmit",
    "e2e": "node e2e/run.mjs",
    "prepare": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "patch:dsh-log": "node scripts/patch-dsh-log.mjs",
    "uninstall:clean": "node scripts/uninstall-clean.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.2-0 || >=0.2.1-rc.5 <0.2.2-0",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.10",
    "playwright": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
