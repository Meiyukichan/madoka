{
  "name": "@meiyukichan/dsh-magica-spellbook",
  "version": "0.2.0-alpha.3",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH 0.2 插件 SDK：会话门面 / 待决交互 / 核心工具层（纯库：运行时零 @deepseek-ai 导入，类型直接引用真实 dsh 包）",
  "engines": {
    "node": ">=22.5",
    "pnpm": ">=11"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js"
    },
    "./directory-browser": {
      "default": "./src/client/directory-browser/DirectoryBrowser.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/client/directory-browser",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:dts",
    "build:js": "node scripts/build.mjs",
    "build:dts": "tsc -p tsconfig.dts.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm build && node scripts/verify.mjs",
    "test": "node --import ./tests/setup.mjs --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:watch": "node --import ./tests/setup.mjs --test --test-isolation=none --watch \"tests/**/*.test.ts\"",
    "version:set": "node scripts/set-version.mjs",
    "clean:report": "node scripts/rm.mjs lib"
  },
  "dependencies": {
    "undici": "^7.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.5 <0.3.0-0",
