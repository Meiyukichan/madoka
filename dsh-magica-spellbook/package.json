    "@deepseek-ai/dsh-session-title": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.5 <0.3.0-0",
